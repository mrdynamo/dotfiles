####################################################################################################
## Machine Type Detection and Configuration
####################################################################################################
{{- $machineClassInput := promptStringOnce . "machineClass" "Machine class ([p] personal / [w] work, default: personal)" -}}
{{- $machineClassChoice := lower (trim $machineClassInput) -}}
{{- $machineClass := "personal" -}}
{{- if or (eq $machineClassChoice "w") (eq $machineClassChoice "work") }}{{- $machineClass = "work" -}}{{- end -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isMacOS := eq .chezmoi.os "darwin" -}}
{{- $isWSL := and $isLinux (contains "microsoft" (lower .chezmoi.kernel.osrelease)) -}}
{{- $platform := "linux" -}}
{{- if $isMacOS }}{{- $platform = "macos" -}}{{- end -}}
{{- if $isWSL }}{{- $platform = "wsl2" -}}{{- end -}}
{{- $isPersonal := eq $machineClass "personal" }}
data:
  isPersonal: {{ $isPersonal }}
  isWork: {{ eq $machineClass "work" }}
  isLinux: {{ $isLinux }}
  isMacOS: {{ $isMacOS }}
  isWSL: {{ $isWSL }}
  machineClass: {{ $machineClass }}
  platform: {{ $platform }}
  profile: {{ $machineClass }}-{{ $platform }}

{{- $opAccount := "" -}}
{{- if or $isWSL $isMacOS -}}
{{- $opCmd := "op" -}}
{{- if $isWSL }}{{- $opCmd = "op.exe" -}}{{- end -}}
{{- $opAccounts := output $opCmd "account" "list" "--format=json" | fromJson -}}
{{- range $opAccounts -}}
{{-   if not (contains "+1passbeta" .email) -}}
{{-     $opAccount = .shorthand -}}
{{-   end -}}
{{- end -}}
{{- end -}}
{{- if or $isLinux $isMacOS }}
####################################################################################################
## 1Password CLI Configuration
####################################################################################################
onepassword:
  command: {{ if $isWSL }}op.exe{{ else }}op{{ end }}
  {{- if and $isLinux (not $isWSL) }}
  mode: service-account
  {{- else }}
  account: {{ $opAccount }}
  {{- end }}
{{- end }}
