## -----------------------------------------------------------------------------
## ~/.zshrc (interactive shell config)
## Purpose:
## - Interactive UX: prompt, aliases, completions, plugins, keybindings
## - Keep login-only PATH/env exports in ~/.zprofile
## -----------------------------------------------------------------------------

## [1] Interactive shell guard
# Exit early for non-interactive shells to keep scripts fast and deterministic.
case "$-" in
  *i*) ;;
  *) return;;
esac

## [2] Prompt bootstrap (must stay near top)
# Powerlevel10k instant prompt should stay near the top for best startup speed.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

## [3] Framework and theme
# oh-my-zsh base path must be set before loading oh-my-zsh.sh.
export ZSH="$HOME/.oh-my-zsh"

# Theme selection must happen before sourcing oh-my-zsh.
ZSH_THEME="powerlevel10k/powerlevel10k"

## [4] Plugin list
# Keep this list lean. kubectl plugin is intentionally excluded because it
# early-exits when kubectl is not on PATH at startup (mise adds it later).
plugins=(common-aliases encode64 git gh kube-ps1 k9s mise zsh-autosuggestions zsh-syntax-highlighting)

## [5] Load oh-my-zsh
if [[ -d "$ZSH" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

## [6] OS-specific aliases
# WSL aliases: only render on WSL2 via chezmoi template condition.
{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
  alias ssh='ssh.exe'
  alias ssh-add='ssh-add.exe'
  alias op='op.exe'
{{- end }}

## [7] Prompt context helpers
if command -v kube_ps1 >/dev/null 2>&1; then
  PROMPT='$(kube_ps1)'$PROMPT
fi

## [8] Interactive runtime managers
# pyenv interactive init belongs here; path init stays in ~/.zprofile.
if command -v pyenv >/dev/null 2>&1; then
  export PYENV_ROOT="$HOME/.pyenv"
  command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init -)"
fi

# nvm: only source when installed.
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck disable=SC1090
  source "$NVM_DIR/nvm.sh"
fi
if [[ -s "$NVM_DIR/bash_completion" ]]; then
  # shellcheck disable=SC1090
  source "$NVM_DIR/bash_completion"
fi

# mise: activate once for directory-aware tool PATH updates.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

## [9] Shell tooling integrations
# Atuin history integration (optional).
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
  eval "$(atuin hex init)"
  source "$HOME/.atuin/bin/env"
fi

## [10] Kubernetes alias + completion
# k alias is intentionally unconditional. In dirs without kubectl on PATH,
# command execution fails normally; in mise-enabled repos it works immediately.
alias k=kubectl

# Completion loading is lazy and one-time, after mise has updated PATH.
_kubectl_completion_loaded=0
_setup_kubectl_completions() {
  (( _kubectl_completion_loaded )) && return
  command -v kubectl >/dev/null 2>&1 || return
  source <(kubectl completion zsh) 2>/dev/null
  compdef __start_kubectl kubectl k 2>/dev/null
  _kubectl_completion_loaded=1
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _setup_kubectl_completions

## [11] Defensive plugin sourcing (fallback)
# Keep these guards in case plugin autoloading is unavailable.
if [[ -f "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
if [[ -f "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

## [12] User customizations
# Put aliases/functions/prompt tweaks below.
# Keep login-only and heavy PATH exports in ~/.zprofile.

export PATH="$HOME/.local/bin:$PATH"

## [13] Prompt config
# Source full p10k config if present.
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

## End of ~/.zshrc
