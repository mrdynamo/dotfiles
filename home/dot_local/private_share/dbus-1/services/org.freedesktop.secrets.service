[D-BUS Service]
# WSL only (see .chezmoiignore). Overrides /usr/share/dbus-1/services/ so that
# D-Bus never auto-starts a gnome-keyring daemon. That daemon would own the
# Secret Service name with a LOCKED login collection, and a client such as
# kubelogin then waits forever on an unlock prompt nobody can answer. Only the
# unlocked daemon that run_always_after_30-keyring.sh starts (directly, not via
# activation) may own the name; until `chezmoi update` runs, clients fail fast.
Name=org.freedesktop.secrets
Exec=/bin/false
