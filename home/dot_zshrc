# Cleaned and guarded ZSH configuration
# Keep login-only environment setup (PATH, pyenv --path, NVM_DIR exports) in ~/.zprofile

# Exit early for non-interactive shells
case "$-" in
  *i*) ;;
  *) return;;
esac

# p10k instant prompt - keep near top for fastest prompt
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation (required before sourcing)
export ZSH="$HOME/.oh-my-zsh"

# Theme selection: set before sourcing oh-my-zsh
ZSH_THEME="powerlevel10k/powerlevel10k"


# Plugins - keep list, but heavy plugins are guarded below if necessary
plugins=(git kubectl kube-ps1 mise zsh-autosuggestions zsh-syntax-highlighting)

# Load oh-my-zsh (fast; uses $ZSH and $plugins above)
if [[ -d "$ZSH" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# Aliases (guarded for WSL / msys where windows executables are available)
if [[ -n $WSL_DISTRO_NAME || "$OSTYPE" == msys ]]; then
  alias ssh='ssh.exe'
  alias ssh-add='ssh-add.exe'
  alias op='op.exe'
fi

# Optionally show kube context in prompt, only if kube_ps1 is available
if command -v kube_ps1 >/dev/null 2>&1; then
  PROMPT='$(kube_ps1)'$PROMPT
fi

# pyenv: keep path-related init in .zprofile; interactive init here if available
if command -v pyenv >/dev/null 2>&1; then
  export PYENV_ROOT="$HOME/.pyenv"
  command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init -)"
fi

# nvm: only source if the nvm script exists (avoid errors in non-standard installs)
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck disable=SC1090
  source "$NVM_DIR/nvm.sh"
fi
if [[ -s "$NVM_DIR/bash_completion" ]]; then
  # shellcheck disable=SC1090
  source "$NVM_DIR/bash_completion"
fi

# mise: guard its activation
if command -v mise >/dev/null 2>&1; then
  # prefer `mise activate zsh` only once
  eval "$(mise activate zsh)"
fi

# Atuin (if installed)
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
  eval "$(atuin hex init)"
  source "$HOME/.atuin/bin/env"
fi

# kubectl completions (guarded)
if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion zsh)
fi

# Example: guard zsh-syntax-highlighting and autosuggestions if plugin didn't autoload
if [[ -f "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
if [[ -f "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# User customizations: keep minimal and fast. Move slow, login-only exports to ~/.zprofile
# alias, functions, and prompt tweaks go below

export PATH="$HOME/.local/bin:$PATH"

# Source the full p10k config if present
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# End of .zshrc
