####################################################################################################
## Common
####################################################################################################

## [1] Interactive shell guard
# Exit early for non-interactive shells to keep scripts fast and deterministic.
case "$-" in
  *i*) ;;
  *) return;;
esac

## [2] Prompt bootstrap (must stay near top)
# Powerlevel10k instant prompt should stay near the top for best startup speed.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

## [2b] Homebrew shellenv
# Use chezmoi machine booleans to choose the likely brew location by platform.
{{- if .isMacOS }}
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi
{{- else if .isLinux }}
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi
{{- else }}
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi
{{- end }}

## [3] Framework and theme
# oh-my-zsh base path must be set before loading oh-my-zsh.sh.
export ZSH="$HOME/.oh-my-zsh"

# Theme selection must happen before sourcing oh-my-zsh.
ZSH_THEME="powerlevel10k/powerlevel10k"

## [4] Plugin list
# Keep this list lean. kubectl plugin is intentionally excluded because it
# early-exits when kubectl is not on PATH at startup (mise adds it later).
plugins=(common-aliases encode64 git gh kube-ps1 k9s mise zsh-autosuggestions zsh-syntax-highlighting)

## [5] Load oh-my-zsh
if [[ -d "$ZSH" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

## [7] Prompt context helpers
if command -v kube_ps1 >/dev/null 2>&1; then
  PROMPT='$(kube_ps1)'$PROMPT
fi

## [8] Interactive runtime managers
# mise: activate once for directory-aware tool PATH updates.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

## [9] Shell tooling integrations
# Atuin history integration (optional).
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
  eval "$(atuin hex init)"
fi

## [11] Defensive plugin sourcing (fallback)
# Keep these guards in case plugin autoloading is unavailable.
if [[ -f "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
if [[ -f "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

## [12] User customizations
# Put aliases/functions/prompt tweaks below.
# Keep login-only and heavy PATH exports in ~/.zprofile.

export PATH="$HOME/.local/bin:$PATH"

## [13] Prompt config
# Source full p10k config if present.
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh


