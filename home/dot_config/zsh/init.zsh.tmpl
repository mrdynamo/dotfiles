####################################################################################################
## Init Configuration
####################################################################################################

## [1] Interactive shell guard
# Exit early for non-interactive shells to keep scripts fast and deterministic.
case "$-" in
  *i*) ;;
  *) return;;
esac

## [1.1] Secret-safe history guards
# Never persist OP service account token exports in zsh history.
_dotfiles_zsh_addhistory_guard() {
  emulate -L zsh
  local cmd="$1"

  if [[ "$cmd" =~ '(^|[[:space:]])OP_SERVICE_ACCOUNT_TOKEN=' ]] || [[ "$cmd" =~ '(^|[[:space:]])export[[:space:]]+OP_SERVICE_ACCOUNT_TOKEN=' ]]; then
    return 1
  fi

  return 0
}
autoload -Uz add-zsh-hook
add-zsh-hook zshaddhistory _dotfiles_zsh_addhistory_guard

# Leading-space commands are ignored by history when this is enabled.
setopt HIST_IGNORE_SPACE

## [2] Prompt bootstrap (must stay near top)
# Powerlevel10k instant prompt should stay near the top for best startup speed.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

## [2.1] OP service account bootstrap for remote Linux
{{- if and .isLinux (not .isWSL) }}
_dotfiles_prompt_op_service_account_token() {
  emulate -L zsh

  # Only prompt on remote SSH sessions when op is installed and token is unset.
  [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]] && return 0
  [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]] || return 0
  command -v op >/dev/null 2>&1 || return 0

  local token=""
  print -P "%F{yellow}1Password service account token required for this host.%f"
  read -r -s "token?Paste OP_SERVICE_ACCOUNT_TOKEN (input hidden): " || return 1
  print

  [[ -n "$token" ]] || return 1
  export OP_SERVICE_ACCOUNT_TOKEN="$token"
  unset token

  # Remove any historical entries that match configured Atuin history filters.
  if command -v atuin >/dev/null 2>&1; then
    atuin history prune >/dev/null 2>&1 || true
  fi
}
_dotfiles_prompt_op_service_account_token
{{- end }}

## [3] Homebrew shellenv
# Use chezmoi machine booleans to choose the likely brew location by platform.
{{- if .isMacOS }}
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi
{{- else if .isLinux }}
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi
{{- else }}
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi
{{- end }}

## [4] Framework and theme
# oh-my-zsh base path must be set before loading oh-my-zsh.sh.
export ZSH="$HOME/.oh-my-zsh"

# Theme selection must happen before sourcing oh-my-zsh.
ZSH_THEME="powerlevel10k/powerlevel10k"

## [5] Plugin list
# Keep this list lean. kubectl plugin is intentionally excluded because it
# early-exits when kubectl is not on PATH at startup (mise adds it later).
plugins=(common-aliases encode64 git gh kube-ps1 k9s mise zsh-autosuggestions zsh-syntax-highlighting)

## [6] Load oh-my-zsh
if [[ -d "$ZSH" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

## [7] Prompt context helpers
if command -v kube_ps1 >/dev/null 2>&1; then
  PROMPT='$(kube_ps1)'$PROMPT
fi

## [8] Interactive runtime managers
# mise: activate once for directory-aware tool PATH updates.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

## [9] Shell tooling integrations
# Atuin history integration (optional).
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
  eval "$(atuin hex init)"
fi

## [10] Defensive plugin sourcing (fallback)
# Keep these guards in case plugin autoloading is unavailable.
if [[ -f "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
if [[ -f "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

## [11] User customizations
# Put aliases/functions/prompt tweaks below.
# Keep login-only and heavy PATH exports in ~/.zprofile.

export PATH="$HOME/.local/bin:$PATH"

## [12] Prompt config
# Source full p10k config if present.
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
