####################################################################################################
## Common
####################################################################################################

# Generated by chezmoi machine profile template.
export DOTFILES_MACHINE_CLASS="{{ .machineClass }}"
export DOTFILES_MACHINE_PLATFORM="{{ .platform }}"
export DOTFILES_MACHINE_PROFILE="{{ .profile }}"
export DOTFILES_PROMPT_TAG="{{ if .isWork }}WORK{{ else }}PERSONAL{{ end }}"

export EDITOR="nano"
export VISUAL="nano"
export PATH="$HOME/.local/bin:$PATH"
export DOTFILES_USE_WINDOWS_SSH=0
export DOTFILES_IS_WSL=0

export OP_EXECUTABLE="${OP_EXECUTABLE:-$(command -v op)}"

{{- if eq .platform "wsl2" }}
####################################################################################################
## WSL Specific
####################################################################################################

export DOTFILES_USE_WINDOWS_SSH=1
export DOTFILES_IS_WSL=1

export BROWSER="powershell.exe Start-Process firefox.exe"
{{- end }}

{{- if .isLinux }}
####################################################################################################
## Linux Specific
####################################################################################################

# The D-Bus session bus. The Secret Service (gnome-keyring) lives on it, and
# the exec plugin that kubectl spawns needs it to reach the keyring. The
# systemd user session provides the socket; where there is no systemd (WSL),
# the keyring script starts a private bus and remembers its address in the
# state file.
#
# `.isLinux` and not `.platform == "linux"`: on WSL the platform is "wsl2".
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    _dotfiles_dbus_address_file="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/dbus-session-address"
    if [[ -r "$_dotfiles_dbus_address_file" ]]; then
        _dotfiles_dbus_address="$(< "$_dotfiles_dbus_address_file")"
        case "$_dotfiles_dbus_address" in
            unix:path=*)
                if [[ -S "${_dotfiles_dbus_address#unix:path=}" ]]; then
                    export DBUS_SESSION_BUS_ADDRESS="$_dotfiles_dbus_address"
                fi
                ;;
        esac
    fi
    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "/run/user/$(id -u)/bus" ]]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
    fi
    unset _dotfiles_dbus_address _dotfiles_dbus_address_file
fi

{{- end }}

