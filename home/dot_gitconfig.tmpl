[user]
  name = mrdynamo
  email = mrdynamo@dynamiclab.org
{{- if and .isPersonal .isLinux (not .isWSL) }}
  signingkey = ~/.ssh/id_ed25519
{{- else }}
  signingkey = {{ onepasswordRead "op://Chezmoi/jvz7ife75zhjagzlfbqkpjfniu/public key" | trim }}
{{- end }}

[gpg]
  format = ssh

# Trusted SSH signing keys for local verification (`git log --show-signature`,
# `git verify-commit`). Without this, SSH-signed commits show as unsigned (N).
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
{{- if .isMacOS }}
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- else if .isWSL }}
{{- $windowsUsername := (output "powershell.exe" "$env:UserName" | trim) }}
  program = /mnt/c/Users/{{ $windowsUsername }}/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe
{{- end }}

{{- if .isWSL }}
[core]
  sshCommand = ssh.exe
{{- end }}

[commit]
  gpgsign = true
