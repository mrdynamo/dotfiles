# Login-only environment setup: place heavy PATH and env exports here
# This file is read by login shells. Keep fast interactive-only config in ~/.zshrc

# Add user-local bin early so installed tools are found in scripts
export PATH="$HOME/.local/bin:$PATH"

# pyenv: initialize the PATH portion here (login-time)
export PYENV_ROOT="$HOME/.pyenv"
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init --path)"
fi

# nvm: make node available for login shells (if installed)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Krew (kubectl plugin manager) path
export KREW_ROOT="${KREW_ROOT:-$HOME/.krew}"
export PATH="${KREW_ROOT}/bin:$PATH"

# Any other slow/login-only exports can be added here.
# Keep interactive-only initialization (prompt, completions, heavy evals)
# in ~/.zshrc to avoid extra work for non-login interactive shells.
