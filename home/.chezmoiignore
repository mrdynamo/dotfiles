# GitHub related items
README.md

# Oh My Zsh runtime cache and compiled bytecode are mutable and should not be
# managed by chezmoi. .zwc files are compiled by zsh at runtime and will always
# differ from what chezmoi originally wrote

.oh-my-zsh/cache/**
.oh-my-zsh/**/*.zwc
.oh-my-zsh/**/*.zwc.old

# Local 1Password service-account token file (host secret, never managed).
.config/op/service-account-token.env
.config/op/config

# SSH keys are provisioned via 1Password templates only on personal native Linux.
# On work Linux, macOS, and WSL the 1Password desktop/agent flow is used instead.
{{- if not (and .isPersonal .isLinux (not .isWSL)) }}
.ssh/**
{{- end }}

# 1Password SSH agent config: macOS path only on personal macOS, Windows path only on Windows, nohing on WSL/Linux.
{{- if and .isMacOS }}
AppData/Local/1Password/config/ssh/agent.toml
{{- else if .isWindows }}
.config/1Password/ssh/agent.toml
{{- else }}
.config/1Password/**
AppData/**
{{- end }}

# macOS-only Library subtree (e.g. Ghostty under
# Application Support/com.mitchellh.ghostty). Personal macOS devices only.
# Pattern uses the TARGET path form (matches what `chezmoi managed` shows),
# NOT the source path with private_ prefix — see the 1Password rule above.
{{- if not (and .isPersonal .isMacOS) }}
Library/**
{{- end }}

# D-Bus activation overrides that stop a LOCKED gnome-keyring daemon from being
# auto-started. WSL only: there the keyring holds nothing but the kubelogin
# token cache and is unlocked by run_always_after_30-keyring.sh. A native Linux
# desktop session relies on activation, so it keeps the packaged files.
{{- if not .isWSL }}
.local/share/dbus-1/**
{{- end }}
