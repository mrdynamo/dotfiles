## -----------------------------------------------------------------------------
## ~/.zprofile (login shell environment)
## Purpose:
## - Login-time PATH and environment exports
## - Keep interactive-only UX setup in ~/.zshrc
## -----------------------------------------------------------------------------

## [1] Base PATH
# Keep user-local bin early so user-installed tools are available everywhere.
export PATH="$HOME/.local/bin:$PATH"

## [2] Python environment bootstrap
# pyenv PATH initialization should happen in login shells.
export PYENV_ROOT="$HOME/.pyenv"
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init --path)"
fi

## [3] Node environment bootstrap
# nvm is loaded for login shells when installed.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

## [4] Kubernetes tooling path
# Krew bin path for kubectl plugins.
export KREW_ROOT="${KREW_ROOT:-$HOME/.krew}"
export PATH="${KREW_ROOT}/bin:$PATH"

## [5] Editor
export EDITOR="nano"
export VISUAL="nano"

